{
	"schema": "evalops.maestro.hosted-orb-delegation.acceptance.v1",
	"version": 1,
	"hosted_only": true,
	"transport": "mcp-streamable-http",
	"amp_like_central_mcp": {
		"configuration_sources": [
			"personal",
			"workspace"
		],
		"surfaces": [
			"orb",
			"tui",
			"runner",
			"puck"
		],
		"project_hosted_configuration": "authoritative",
		"local_invocation_mcp_config": "ignored",
		"transport": "mcp-streamable-http",
		"auth_modes": [
			"oauth",
			"bearer"
		],
		"credential_flow": "opaque-hosted",
		"server": "fixture-remote-mcp",
		"includeTools": [
			"fixture_lookup"
		],
		"disallowed_tools": [
			"fixture_admin",
			"fixture_secret"
		],
		"evidence": [
			"approval",
			"lifecycle",
			"tool_call",
			"tool_result"
		]
	},
	"atomic_launch": {
		"primitive": "computer_launch",
		"compatibility_alias": "orb_launch_hosted_task",
		"required_launch_arguments": [
			"project",
			"repository_url",
			"prompt",
			"idempotency_key"
		],
		"optional_launch_arguments": [
			"agent",
			"model",
			"runtime_profile",
			"max_run_cost_credits"
		],
		"default_profile_sources": [
			"server"
		],
		"forbidden_client_arguments": [
			"provider",
			"machine",
			"provisioner"
		],
		"client_flow": "single_command",
		"forbidden_client_sequence": [
			"create_thread",
			"start_task",
			"wait_task",
			"send_message"
		],
		"required_handle": [
			"thread_id",
			"receipt_id"
		],
		"catalog": {
			"discovery_required": true,
			"allowed_profiles": [
				"sandboxwich/standard/sandboxed_container/unprivileged",
				"sandboxwich/restricted/sandboxed_container/unprivileged"
			]
		},
		"receipt_before_completion": true,
		"rejection_must_be_side_effect_free": true,
		"required_evidence": [
			"profile",
			"placement",
			"receipt",
			"lifecycle",
			"cancellation"
		]
	},
	"tools": {
		"orb_list_hosted_runtime_profiles": {
			"scope": "tasks:read",
			"method": "GET",
			"path": "/hosted/runtime-profiles",
			"idempotent": true
		},
		"computer_launch": {
			"scope": "executor:write",
			"additional_scopes": [
				"tasks:write",
				"threads:write"
			],
			"method": "POST",
			"path": "/hosted/launches",
			"idempotent": true,
			"idempotency_argument": "idempotency_key"
		},
		"orb_launch_hosted_task": {
			"scope": "executor:write",
			"additional_scopes": [
				"tasks:write",
				"threads:write"
			],
			"method": "POST",
			"path": "/hosted/launches",
			"idempotent": true,
			"idempotency_argument": "idempotency_key"
		},
		"orb_create_thread": {
			"scope": "threads:write",
			"method": "POST",
			"path": "/threads",
			"idempotent": false
		},
		"orb_start_task": {
			"scope": "executor:write",
			"method": "POST",
			"path": "/threads/{id}/launches",
			"idempotent": true,
			"idempotency_argument": "idempotency_key"
		},
		"orb_wait_task": {
			"scope": "threads:read",
			"method": "GET",
			"path": "/launch-replays/{id}",
			"idempotent": true
		},
		"orb_send_message": {
			"scope": "threads:write",
			"method": "POST",
			"path": "/threads/{id}/messages",
			"idempotent": false
		},
		"orb_get_thread": {
			"scope": "threads:read",
			"method": "GET",
			"path": "/threads/{id}/report",
			"idempotent": true
		},
		"orb_list_pending_approvals": {
			"scope": "threads:read",
			"method": "GET",
			"path": "/threads",
			"additional_paths": [
				"/threads/{id}/report"
			],
			"idempotent": true
		},
		"orb_decide_approval": {
			"scope": "approvals:write",
			"method": "POST",
			"path": "/threads/{id}/approvals",
			"idempotent": false
		},
		"orb_task_status": {
			"scope": "tasks:read",
			"method": "GET",
			"path": "/tasks/{id}",
			"idempotent": true
		},
		"orb_direct_task": {
			"scope": "tasks:write",
			"method": "POST",
			"path": "/tasks/{id}/directives",
			"idempotent": true,
			"idempotency_argument": "idempotency_key"
		},
		"orb_cancel_task": {
			"scope": "tasks:write",
			"method": "POST",
			"path": "/tasks/{id}/commands",
			"idempotent": true,
			"idempotency_argument": "idempotency_key"
		}
	},
	"cases": [
		{
			"id": "hosted_authentication",
			"required_scopes": [
				"threads:read",
				"threads:write"
			],
			"operations": [
				{
					"name": "unauthenticated_initialize",
					"operation": "initialize",
					"outcome": "rejected"
				},
				{
					"name": "authenticated_initialize",
					"operation": "initialize",
					"outcome": "accepted"
				},
				{
					"name": "scoped_tool_catalog",
					"operation": "list_tools",
					"outcome": "accepted"
				}
			],
			"assertions": [
				"Every MCP request requires tenant authentication.",
				"The authenticated catalog contains only tools allowed by the tenant scopes.",
				"Authentication material is absent from recorded evidence."
			]
		},
		{
			"id": "start_wait_message",
			"required_scopes": [
				"threads:write",
				"executor:write",
				"threads:read"
			],
			"operations": [
				{
					"name": "create_thread",
					"tool": "orb_create_thread",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "start_task",
					"tool": "orb_start_task",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "wait_for_ready",
					"tool": "orb_wait_task",
					"operation": "call_tool",
					"outcome": "ready"
				},
				{
					"name": "send_message",
					"tool": "orb_send_message",
					"operation": "call_tool",
					"outcome": "accepted"
				}
			],
			"assertions": [
				"A fresh thread uses a durable launch receipt before sending a message.",
				"The message is sent only after the receipt reaches ready."
			]
		},
		{
			"id": "disconnect_reconnect",
			"required_scopes": [
				"threads:read"
			],
			"operations": [
				{
					"name": "initial_thread_read",
					"tool": "orb_get_thread",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "reconnect_initialize",
					"operation": "initialize",
					"outcome": "accepted"
				},
				{
					"name": "reconnected_thread_read",
					"tool": "orb_get_thread",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "reconnected_wait",
					"tool": "orb_wait_task",
					"operation": "call_tool",
					"outcome": "ready"
				}
			],
			"assertions": [
				"A new MCP session can resume by durable thread and receipt identifiers.",
				"Reconnect does not create a second thread or launch."
			]
		},
		{
			"id": "steering",
			"required_scopes": [
				"tasks:write",
				"tasks:read"
			],
			"operations": [
				{
					"name": "submit_directive",
					"tool": "orb_direct_task",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "observe_directive",
					"tool": "orb_task_status",
					"operation": "call_tool",
					"outcome": "active"
				}
			],
			"assertions": [
				"Steering uses the task directive endpoint and a caller idempotency key.",
				"The task status remains tenant-scoped after steering."
			]
		},
		{
			"id": "approval",
			"required_scopes": [
				"threads:read",
				"threads:write",
				"approvals:write"
			],
			"operations": [
				{
					"name": "start_approval_task",
					"tool": "orb_start_task",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "send_approval_message",
					"tool": "orb_send_message",
					"operation": "call_tool",
					"outcome": "held"
				},
				{
					"name": "list_pending",
					"tool": "orb_list_pending_approvals",
					"operation": "call_tool",
					"outcome": "pending"
				},
				{
					"name": "approve_call",
					"tool": "orb_decide_approval",
					"operation": "call_tool",
					"outcome": "accepted"
				}
			],
			"assertions": [
				"A held approval is visible before a decision is submitted.",
				"The decision names the pending thread and tool call."
			]
		},
		{
			"id": "cancellation",
			"required_scopes": [
				"tasks:write",
				"tasks:read"
			],
			"operations": [
				{
					"name": "cancel_task",
					"tool": "orb_cancel_task",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "observe_cancelled",
					"tool": "orb_task_status",
					"operation": "call_tool",
					"outcome": "cancelled"
				}
			],
			"assertions": [
				"Cancellation is a durable task command.",
				"The terminal task outcome is cancelled rather than an infrastructure error."
			]
		},
		{
			"id": "idempotent_retry",
			"required_scopes": [
				"executor:write",
				"threads:read"
			],
			"operations": [
				{
					"name": "initial_start",
					"tool": "orb_start_task",
					"operation": "call_tool",
					"outcome": "accepted"
				},
				{
					"name": "same_key_retry",
					"tool": "orb_start_task",
					"operation": "call_tool",
					"outcome": "same_receipt"
				},
				{
					"name": "changed_request_conflict",
					"tool": "orb_start_task",
					"operation": "call_tool",
					"outcome": "conflict"
				}
			],
			"assertions": [
				"An identical start retry returns the original receipt.",
				"Reusing a key with a different request fails closed and does not launch twice."
			]
		},
		{
			"id": "terminal_result",
			"required_scopes": [
				"threads:read",
				"tasks:read"
			],
			"operations": [
				{
					"name": "collect_thread_report",
					"tool": "orb_get_thread",
					"operation": "call_tool",
					"outcome": "completed"
				},
				{
					"name": "collect_task_status",
					"tool": "orb_task_status",
					"operation": "call_tool",
					"outcome": "succeeded"
				}
			],
			"assertions": [
				"Terminal collection includes both the thread report and task status.",
				"The result has an explicit terminal outcome and no credential material."
			]
		},
		{
			"id": "tenant_isolation",
			"required_scopes": [
				"threads:read"
			],
			"operations": [
				{
					"name": "same_tenant_read",
					"tool": "orb_get_thread",
					"operation": "call_tool",
					"outcome": "accepted",
					"tenant": "tenant-a"
				},
				{
					"name": "cross_tenant_thread_read",
					"tool": "orb_get_thread",
					"operation": "call_tool",
					"outcome": "rejected",
					"tenant": "tenant-b"
				},
				{
					"name": "cross_tenant_receipt_read",
					"tool": "orb_wait_task",
					"operation": "call_tool",
					"outcome": "rejected",
					"tenant": "tenant-b"
				}
			],
			"assertions": [
				"A tenant cannot read another tenant's thread or launch receipt.",
				"Cross-tenant errors do not disclose the other tenant's transcript or identifiers."
			]
		},
		{
			"id": "central_mcp_allowlist_auth",
			"required_scopes": [
				"executor:write",
				"threads:read"
			],
			"operations": [
				{
					"name": "project_hosted_config_wins",
					"operation": "central_configure",
					"outcome": "accepted"
				},
				{
					"name": "opaque_hosted_auth",
					"operation": "central_authenticate",
					"outcome": "accepted"
				},
				{
					"name": "include_tools_discovery",
					"operation": "central_tools_list",
					"outcome": "filtered"
				}
			],
			"assertions": [
				"Personal or workspace configuration reaches the hosted Computer through project-hosted authority.",
				"A local per-invocation mcp_config is ignored inside the hosted Computer.",
				"Streamable HTTP authentication uses an opaque hosted credential reference.",
				"includeTools exposes fixture_lookup and hides fixture_admin and fixture_secret."
			]
		},
		{
			"id": "central_mcp_tool_call_evidence",
			"required_scopes": [
				"executor:write",
				"threads:read",
				"approvals:write"
			],
			"operations": [
				{
					"name": "allowlisted_tool_call",
					"operation": "central_tool_call",
					"remote_tool": "fixture_lookup",
					"outcome": "accepted"
				},
				{
					"name": "approval_evidence",
					"operation": "approval_evidence",
					"evidence": "approval",
					"outcome": "recorded"
				},
				{
					"name": "lifecycle_evidence",
					"operation": "lifecycle_evidence",
					"evidence": "lifecycle",
					"outcome": "recorded"
				},
				{
					"name": "tool_result_evidence",
					"operation": "tool_result_evidence",
					"evidence": "tool_result",
					"outcome": "recorded"
				}
			],
			"assertions": [
				"The agent calls only the centrally allowlisted remote tool.",
				"Approval, lifecycle, tool-call, and tool-result evidence are recorded without credentials."
			]
		},
		{
			"id": "central_mcp_restart_reconnect",
			"required_scopes": [
				"executor:write",
				"threads:read"
			],
			"operations": [
				{
					"name": "restart_remote_session",
					"operation": "central_restart",
					"outcome": "accepted"
				},
				{
					"name": "reconnect_remote_session",
					"operation": "central_reconnect",
					"outcome": "accepted"
				},
				{
					"name": "reconnected_tools_discovery",
					"operation": "central_tools_list",
					"outcome": "filtered"
				},
				{
					"name": "reconnected_tool_call",
					"operation": "central_tool_call",
					"remote_tool": "fixture_lookup",
					"outcome": "accepted"
				}
			],
			"assertions": [
				"A hosted restart and reconnect preserve the central configuration and tool allowlist.",
				"The allowlisted remote tool remains callable after reconnect without a new credential disclosure."
			]
		},
		{
			"id": "central_mcp_revoked_credential",
			"required_scopes": [
				"executor:write",
				"threads:read"
			],
			"operations": [
				{
					"name": "revoked_opaque_auth",
					"operation": "central_authenticate",
					"outcome": "rejected"
				},
				{
					"name": "revoked_lifecycle_evidence",
					"operation": "lifecycle_evidence",
					"evidence": "lifecycle",
					"outcome": "recorded"
				}
			],
			"assertions": [
				"A revoked hosted credential fails authentication without falling back to a raw local secret.",
				"The rejected authentication and terminal lifecycle are recorded without provisioning a new credential."
			]
		},
		{
			"id": "hosted_profile_discovery",
			"required_scopes": [
				"tasks:read"
			],
			"operations": [
				{
					"name": "discover_profiles",
					"operation": "profile_catalog",
					"outcome": "accepted"
				},
				{
					"name": "select_allowed_profile",
					"operation": "profile_selection",
					"profile": "sandboxwich/standard/sandboxed_container/unprivileged",
					"outcome": "accepted"
				}
			],
			"assertions": [
				"A managed hosted control plane exposes an explicit runtime-profile catalog before launch.",
				"The selected profile is one of the catalog's allowed profiles."
			]
		},
		{
			"id": "atomic_launch_receipt",
			"required_scopes": [
				"executor:write",
				"tasks:write",
				"threads:write"
			],
			"operations": [
				{
					"name": "admit_atomic_launch",
					"operation": "atomic_launch",
					"profile": "sandboxwich/standard/sandboxed_container/unprivileged",
					"profile_mode": "default",
					"outcome": "accepted"
				},
				{
					"name": "same_atomic_key_retry",
					"operation": "atomic_launch",
					"profile": "sandboxwich/standard/sandboxed_container/unprivileged",
					"profile_mode": "default",
					"outcome": "same_receipt"
				},
				{
					"name": "observe_durable_receipt",
					"operation": "receipt_observation",
					"outcome": "durable"
				},
				{
					"name": "record_profile_placement",
					"operation": "placement_evidence",
					"evidence": "placement",
					"outcome": "recorded"
				}
			],
			"assertions": [
				"One control-plane command admits the task, provisions or wakes the managed instance, and starts the agent.",
				"A durable idempotent receipt is observable before task completion.",
				"The receipt proves the selected profile and managed placement."
			]
		},
		{
			"id": "atomic_launch_allowed_override",
			"required_scopes": [
				"executor:write",
				"tasks:write",
				"threads:write"
			],
			"operations": [
				{
					"name": "admit_allowed_override",
					"operation": "atomic_launch",
					"profile": "sandboxwich/restricted/sandboxed_container/unprivileged",
					"profile_mode": "override",
					"outcome": "accepted"
				},
				{
					"name": "override_handle_observed",
					"operation": "receipt_observation",
					"outcome": "durable"
				}
			],
			"assertions": [
				"An optional allowed profile override succeeds through the same single hosted launch command.",
				"The override response exposes a durable thread/launch handle and managed placement."
			]
		},
		{
			"id": "atomic_launch_reconnect_cancel",
			"required_scopes": [
				"executor:write",
				"tasks:read",
				"tasks:write"
			],
			"operations": [
				{
					"name": "reconnect_atomic_launch",
					"operation": "atomic_reconnect",
					"outcome": "accepted"
				},
				{
					"name": "observe_atomic_status",
					"operation": "atomic_status",
					"outcome": "accepted"
				},
				{
					"name": "steer_atomic_launch",
					"operation": "atomic_steer",
					"outcome": "accepted"
				},
				{
					"name": "cancel_atomic_launch",
					"operation": "atomic_cancel",
					"outcome": "accepted"
				},
				{
					"name": "observe_atomic_cancelled",
					"operation": "atomic_status",
					"outcome": "cancelled"
				}
			],
			"assertions": [
				"Reconnect resumes the atomic launch by its durable receipt.",
				"Status and cancellation remain tenant-scoped and refer to the same receipt."
			]
		},
		{
			"id": "atomic_launch_rejected_profile",
			"required_scopes": [
				"executor:write",
				"tasks:write",
				"threads:write"
			],
			"operations": [
				{
					"name": "reject_unavailable_profile",
					"operation": "atomic_launch",
					"profile": "sandboxwich/unavailable/sandboxed_container/unprivileged",
					"profile_mode": "override",
					"outcome": "rejected"
				},
				{
					"name": "no_provisioning_side_effect",
					"operation": "provisioning_side_effect",
					"outcome": "none"
				}
			],
			"assertions": [
				"An unavailable or unauthorized profile fails before provisioning side effects.",
				"The rejection is reported as a source/control-plane outcome, not a capacity incident."
			]
		}
	],
	"recorded_exchanges": [
		{
			"case_id": "hosted_authentication",
			"name": "unauthenticated_initialize",
			"operation": "initialize",
			"tenant": "tenant-a",
			"request": {
				"authenticated": false
			},
			"response": {
				"accepted": false,
				"status": 401
			}
		},
		{
			"case_id": "hosted_authentication",
			"name": "authenticated_initialize",
			"operation": "initialize",
			"tenant": "tenant-a",
			"request": {
				"authenticated": true
			},
			"response": {
				"accepted": true,
				"session": "session-a"
			}
		},
		{
			"case_id": "hosted_authentication",
			"name": "scoped_tool_catalog",
			"operation": "list_tools",
			"tenant": "tenant-a",
			"request": {
				"scopes": [
					"threads:read",
					"threads:write"
				]
			},
			"response": {
				"accepted": true,
				"tools": [
					"orb_get_thread",
					"orb_create_thread",
					"orb_send_message"
				]
			}
		},
		{
			"case_id": "start_wait_message",
			"name": "create_thread",
			"operation": "call_tool",
			"tenant": "tenant-a",
			"request": {
				"tool": "orb_create_thread",
				"arguments": {
					"project": "fixture-project",
					"title": "delegation-1"
				}
			},
			"response": {
				"thread_id": "thread-a",
				"tenant": "tenant-a"
			}
		},
		{
