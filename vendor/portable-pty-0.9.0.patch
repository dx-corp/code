+#[cfg(target_os = "linux")]
+fn openpty_cloexec(size: &winsize) -> io::Result<(RawFd, RawFd)> {
+    // Setting FD_CLOEXEC after openpty leaves a window in which a concurrent
+    // fork/exec can retain the slave and prevent the terminal reader seeing EOF.
+    // Both descriptors must carry the flag from the instant they are created.
+    let flags = libc::O_RDWR | libc::O_NOCTTY | libc::O_CLOEXEC;
+    // SAFETY: posix_openpt takes only an open-flags value.
+    let master = unsafe { libc::posix_openpt(flags) };
+    if master == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: posix_openpt returned a new descriptor owned by this function.
+    let master = unsafe { OwnedFd::from_raw_fd(master) };
+    // SAFETY: master is a valid, owned PTY master.
+    if unsafe { libc::grantpt(master.as_raw_fd()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: the granted PTY master remains valid and owned here.
+    if unsafe { libc::unlockpt(master.as_raw_fd()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: TIOCGPTPEER opens this master's slave with the supplied flags.
+    let slave = unsafe { libc::ioctl(master.as_raw_fd(), libc::TIOCGPTPEER, flags) };
+    if slave == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: the successful TIOCGPTPEER call returned a new owned descriptor.
+    let slave = unsafe { OwnedFd::from_raw_fd(slave) };
+    // SAFETY: slave is valid and size points to an initialized winsize.
+    if unsafe { libc::ioctl(slave.as_raw_fd(), libc::TIOCSWINSZ, size) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok((master.into_raw_fd(), slave.into_raw_fd()))
 }
 
