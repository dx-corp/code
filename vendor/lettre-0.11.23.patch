+
+async fn read_response_line<R: AsyncBufRead + Unpin>(
+    stream: &mut R,
+    buffer: &mut String,
+) -> Result<usize, Error> {
+    let mut line = ResponseLine::new(buffer.len());
+    loop {
+        let available = stream.fill_buf().await.map_err(error::network)?;
+        if available.is_empty() {
+            return line.finish(buffer);
+        }
+        let (consumed, complete) = line.extend(available)?;
+        stream.consume_unpin(consumed);
+        if complete {
+            return line.finish(buffer);
+        }
+    }
