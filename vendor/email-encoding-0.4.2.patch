     use pretty_assertions::assert_eq;
 
     use super::*;
+
+    // Count output without retaining it, and stop a broken encoder safely.
+    struct BudgetWriter {
+        remaining: usize,
+        exhausted: bool,
+    }
+
+    impl Write for BudgetWriter {
+        fn write_str(&mut self, value: &str) -> fmt::Result {
+            if value.len() > self.remaining {
+                self.exhausted = true;
+                return Err(fmt::Error);
+            }
+            self.remaining -= value.len();
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn long_key_unicode_fails_before_exhausting_writer() {
+        for key_len in 49..=62 {
+            let key = "a".repeat(key_len);
+            for value in ["é", "📕", "aé"] {
+                let mut sink = BudgetWriter {
+                    remaining: 16_384,
+                    exhausted: false,
+                };
+                let result = {
+                    let mut w = EmailWriter::new(&mut sink, 0, 0, false);
+                    encode(&key, value, &mut w)
+                };
+                assert!(result.is_err(), "key length {key_len}, value {value}");
+                assert!(!sink.exhausted, "key length {key_len}, value {value}");
+            }
+        }
+    }
+
+    #[test]
+    fn long_key_plain_fails_before_exhausting_writer() {
+        let key = "a".repeat(62);
+        // The first million segments consume 1,111,110 bytes. The next
+        // segment number leaves no space for the last byte of the value.
+        let value = "a".repeat(1_111_111);
+        let mut sink = BudgetWriter {
+            remaining: 128 * 1024 * 1024,
+            exhausted: false,
+        };
+        let result = {
+            let mut w = EmailWriter::new(&mut sink, 0, 0, false);
+            encode(&key, &value, &mut w)
+        };
+        assert!(result.is_err());
+        assert!(!sink.exhausted);
+    }
+
+    #[test]
+    fn line_length_overflow_returns_error() {
+        let mut output = String::new();
+        let result = {
+            let mut w = EmailWriter::new(&mut output, usize::MAX, 0, false);
+            encode("filename", "duck.txt", &mut w)
+        };
+        assert!(result.is_err());
+        assert!(output.is_empty());
+    }
+
+    #[test]
+    fn longest_unicode_key_with_room_encodes_value() {
+        let key = "a".repeat(48);
+        let mut output = String::new();
+        {
+            let mut w = EmailWriter::new(&mut output, 0, 0, false);
+            encode(&key, "📕", &mut w).unwrap();
+        }
+        assert_eq!(output, alloc::format!("\r\n {key}*0*=utf-8''%F0%9F%93%95"));
+    }
 
