# Native library consumed by the Platform Bazel service graph.
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

rust_library(
    name = "maestro_ai",
    deps = [
        "@crates//:anyhow-1.0.103",
        "@crates//:base64-0.22.1",
        "@crates//:eventsource-stream-0.2.3",
        "@crates//:futures-0.3.32",
        "//products/maestro/packages/runtime-contracts-rs:maestro_runtime_contracts",
        "@crates//reqwest",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:tokio-1.52.3",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.4",
        "@crates//:wait-timeout-0.2.1",
    ],
    compile_data = glob(
        allow_empty = True,
        include = ["**"],
        exclude = [
            "**/* *",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env_files = [
        ":cargo_toml_env_vars",
    ],
    srcs = glob(
        allow_empty = True,
        include = ["**/*.rs"],
    ),
    target_compatible_with = select({
        "@rules_rust//rust/platform:x86_64-unknown-linux-gnu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = "0.1.0",
)
