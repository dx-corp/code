# Native library consumed by the Platform Bazel service graph.
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

rust_library(
    name = "maestro_runtime",
    deps = [
        "@crates//:anyhow-1.0.103",
        "@crates//:base64-0.22.1",
        "@crates//:chrono-0.4.45",
        "@crates//:dirs-7.0.0",
        "@crates//:futures-0.3.32",
        "//products/maestro/packages/ai-rs:maestro_ai",
        "//products/maestro/packages/codex-rs:maestro_codex",
        "//products/maestro/packages/coding-acceptance-rs:maestro_coding_acceptance",
        "//products/maestro/packages/context-rs:maestro_context",
        "//products/maestro/packages/runtime-contracts-rs:maestro_runtime_contracts",
        "//products/maestro/packages/sandbox-rs:maestro_sandbox",
        "@crates//:rand-0.10.1",
        "@crates//:regex-1.13.0",
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:sha2-0.10.9",
        "@crates//:tempfile-3.27.0",
        "@crates//:thiserror-2.0.18",
        "@crates//:tokio-1.52.3",
        "@crates//:tokio-util-0.7.18",
        "@crates//:tracing-0.1.44",
        "@crates//:uuid-1.23.4",
        "@crates//:zeroize-1.9.0",
    ],
    compile_data = glob(
        allow_empty = True,
        include = ["**"],
        exclude = [
            "**/* *",
            ".tmp_git_root/**/*",
            "BUILD",
            "BUILD.bazel",
            "WORKSPACE",
            "WORKSPACE.bazel",
        ],
    ),
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env_files = [
        ":cargo_toml_env_vars",
    ],
    srcs = glob(
        allow_empty = True,
        include = ["**/*.rs"],
    ),
    target_compatible_with = select({
        "@rules_rust//rust/platform:x86_64-unknown-linux-gnu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = "0.1.0",
)
